#-----------------------------------------------------
# Model Caches
#-----------------------------------------------------

# set to 1 after the first run to start offline
HF_HUB_OFFLINE=0
HF_HOME=./data/huggingface
FASTEMBED_CACHE_PATH=./data/fastembed

#-----------------------------------------------------
# Limits & Resilience
#-----------------------------------------------------

RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=15
SEARCH_MAX_CONCURRENCY=16
SEARCH_TIMEOUT=30

#-----------------------------------------------------
# Auth (OpenWebUI JWT)
#-----------------------------------------------------

JWT_SECRET=changeme
JWT_ALGORITHM=HS256

#-----------------------------------------------------
# S3 Storage
#-----------------------------------------------------

# must be reachable by the user's browser too — presigned source URLs embed this host
# (compose binds MinIO to 127.0.0.1 — widen its port mapping for other machines)
MINIO_URL=http://192.168.xxx.xxx:9000
MINIO_USER=minio
MINIO_PASSWORD=whatever
MINIO_BUCKET=default
MINIO_URL_EXPIRE=3600

#-----------------------------------------------------
# Document Store
#-----------------------------------------------------

QDRANT_URL=http://qdrant:6333
QDRANT_TOKEN=whatever
QDRANT_TIMEOUT=30
# must match DENSE_EMBEDDING_MODEL (bge-m3: 1024)
QDRANT_EMBEDDING_DIM=1024
QDRANT_COLLECTION=aragog

#-----------------------------------------------------
# Converter
#-----------------------------------------------------

DOCLING_URL=http://docling:5001
DOCLING_TIMEOUT=600

#-----------------------------------------------------
# Document Chunker
#-----------------------------------------------------

# should match DENSE_EMBEDDING_MODEL so chunk token counts line up
CHUNKER_TOKENIZER=BAAI/bge-m3
CHUNKER_MAX_TOKENS=1000

#-----------------------------------------------------
# Enricher
#-----------------------------------------------------

# any OpenAI-compatible endpoint; model must support structured output (json_schema)
ENRICHER_MODEL=deepseek/deepseek-v4-flash
ENRICHER_URL=https://openrouter.ai/api/v1
ENRICHER_TOKEN=whatever
ENRICHER_TIMEOUT=180
# keep low — timeout retries multiply load on a saturated endpoint
ENRICHER_MAX_RETRIES=1
ENRICHER_MAX_WORKERS=3
# must match SPARSE_EMBEDDING_LANGUAGE and the corpus, or BM25 breaks
ENRICHER_LANGUAGE=english

#-----------------------------------------------------
# Embedders (Dense + Sparse)
#-----------------------------------------------------

DENSE_EMBEDDING_MODEL=BAAI/bge-m3
DENSE_EMBEDDING_URL=http://embedder:8000/v1
DENSE_EMBEDDING_TOKEN=whatever
# keep below SEARCH_TIMEOUT so transient retries fit the deadline
DENSE_EMBEDDING_TIMEOUT=15

SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# keep identical between indexing and querying
SPARSE_EMBEDDING_LANGUAGE=english
SPARSE_EMBEDDING_DEVICE=cpu

# enrichment fields embedded together with the chunk content (dense + sparse)
EMBEDDED_META_FIELDS=context,keywords,headings,hypothetical_questions

#-----------------------------------------------------
# Reranker
#-----------------------------------------------------

RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_URL=http://reranker:8000/v1
RERANKER_TOKEN=whatever
# keep below SEARCH_TIMEOUT so a hung reranker surfaces before the deadline
RERANKER_TIMEOUT=15
# hits scoring below this (0-1) are dropped from results
RERANKER_SCORE_THRESHOLD=0.2
